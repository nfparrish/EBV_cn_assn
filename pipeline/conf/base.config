params {
  manifest = null
  outdir = 'results'
  status_registry = null
}

process {
  cpus = 1
  memory = '2 GB'
  time = '2h'

  withLabel:manifest_validation {
    cpus = 1
    memory = '2 GB'
    time = '1h'
  }

  withLabel:staging {
    cpus = 1
    memory = '1 GB'
    time = '1h'
  }

  withLabel:status_tracking {
    cpus = 1
    memory = '1 GB'
    time = '30m'
  }
}

profiles {
  standard {
    process.executor = 'local'
  }

  slurm {
    process.executor = 'slurm'
    singularity.enabled = true
    singularity.autoMounts = true
  }

  pbs {
    process.executor = 'pbs'
    singularity.enabled = true
    singularity.autoMounts = true
  }
}
