params {
  manifest = null
  outdir = 'results'
  status_registry = null
  workflow = 'intake'

  reference_accession = 'NC_007605'
  viral_reference_fasta = null
  cn_host_baseline = 'autosomal_depth'
  cn_methods = 'depth_ratio,read_count_ratio'

  variant_caller = 'mutect2'
  variant_filter_profile = 'balanced'
  variant_binary_af_threshold = 0.05
  variant_filter_ebv_min_af = 0.05
  variant_filter_ebv_min_dp = 20
  variant_filter_ebv_min_qual = 60
  variant_filter_host_min_dosage = 1.0
  host_variant_input = null
  host_variant_format = 'tsv'

  association_covariates_input = null
  association_cn_column = 'depth_ratio_cn_norm'
  association_model_family = 'gaussian'
  association_model_link = 'identity'
  association_multiple_testing = 'fdr_bh'
  association_min_samples = 3

  rna_expression_input = null
  rna_metadata_input = null
  rna_input_mode = 'auto'
  rna_require_ebv_genes = true
  rna_normalization_methods = 'log2_tpm,quantile'
  rna_reference_fasta = null
  rna_reference_gtf = null
  rna_aligner = 'minimap2'
  rna_counter = 'auto'
  rna_threads = 2
  rna_assoc_model_family = 'gaussian'
  rna_assoc_model_link = 'identity'
  rna_assoc_multiple_testing = 'fdr_bh'
  rna_assoc_min_samples = 3
  rna_expected_coding_variants = 'NC_007605:734:A>G,NC_007605:3101:C>T,NC_007605:5843:G>A,NC_007605:10011:T>C,NC_007605:14682:A>C'
  rna_expected_donor_variants_input = null
}

process {
  cpus = 1
  memory = '2 GB'
  time = '2h'

  withLabel:manifest_validation {
    cpus = 1
    memory = '2 GB'
    time = '1h'
  }

  withLabel:staging {
    cpus = 1
    memory = '1 GB'
    time = '1h'
  }

  withLabel:status_tracking {
    cpus = 1
    memory = '1 GB'
    time = '30m'
  }

  withLabel:cn_compute {
    cpus = 1
    memory = '2 GB'
    time = '2h'
  }

  withLabel:variant_compute {
    cpus = 1
    memory = '2 GB'
    time = '2h'
  }

  withLabel:assoc_compute {
    cpus = 1
    memory = '2 GB'
    time = '2h'
  }

  withLabel:rna_compute {
    cpus = 1
    memory = '2 GB'
    time = '2h'
  }
}

profiles {
  standard {
    process.executor = 'local'
  }

  slurm {
    process.executor = 'slurm'
    singularity.enabled = true
    singularity.autoMounts = true
  }

  pbs {
    process.executor = 'pbs'
    singularity.enabled = true
    singularity.autoMounts = true
  }
}
